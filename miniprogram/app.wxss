/* ============================================
   书染美术 - 晴空蓝·明朗欢快设计系统
   Primary:    #4A9ECC (晴空蓝)
   Accent:     #F5C842 (明黄)
   Background: #F0F7FF (天空白)
   Text:       #1A2E3D / #6A8099
   ============================================ */

/* 全局样式 */
page {
  background: #F0F7FF;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #1A2E3D;
  line-height: 1.6;
  min-height: 100vh;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #4A9ECC;
}

.custom-nav-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.custom-nav-back {
  position: absolute;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.custom-nav-back::before {
  content: '';
  display: block;
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
}

/* 主题颜色 */
.primary-color { color: #4A9ECC; }
.secondary-color { color: #3A8EBC; }
.accent-color { color: #F5C842; }
.primary-bg { background: #4A9ECC; }
.secondary-bg { background: #3A8EBC; }

/* 通用容器 */
.container { padding: 24rpx; }

/* ============================================
   卡片样式 - 轻盈明亮
   ============================================ */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(74, 158, 204, 0.1);
  transition: all 200ms ease-out;
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 8rpx rgba(74, 158, 204, 0.12);
}

.card-glass {
  background: rgba(255, 255, 255, 0.88);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(74, 158, 204, 0.1);
}

.card-accent {
  background: #4A9ECC;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 158, 204, 0.3);
  color: #FFFFFF;
}

/* ============================================
   按钮样式
   ============================================ */

/* 重置微信 button 默认样式 */
button {
  margin: 0;
  padding: 0;
  line-height: inherit;
  font-size: inherit;
  text-align: center;
}

button::after {
  border: none;
}

.btn-primary {
  background: #4A9ECC;
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(74, 158, 204, 0.35);
  transition: all 200ms ease-out;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(74, 158, 204, 0.35);
  background: #3A8EBC;
}

.btn-secondary {
  background: #FFFFFF;
  color: #4A9ECC;
  border: 2rpx solid #4A9ECC;
  border-radius: 50rpx;
  padding: 22rpx 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 200ms ease-out;
}

.btn-secondary:active {
  background: #E8F4FB;
  transform: translateY(2rpx);
}

.btn-small {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  border-radius: 40rpx;
}

/* ============================================
   文本样式
   ============================================ */
.text-center { text-align: center; }
.text-bold { font-weight: 700; }
.text-semibold { font-weight: 600; }
.text-gray { color: #6A8099; }
.text-muted { color: #A0B4C5; }
.text-primary { color: #4A9ECC; }
.text-small { font-size: 24rpx; }
.text-large { font-size: 34rpx; }
.text-title { font-size: 40rpx; font-weight: 700; color: #1A2E3D; }
.text-subtitle { font-size: 32rpx; font-weight: 600; color: #1A2E3D; }

/* ============================================
   Flex 布局
   ============================================ */
.flex { display: flex; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-around { display: flex; justify-content: space-around; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }

/* ============================================
   间距系统
   ============================================ */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.pt-16 { padding-top: 16rpx; }
.pt-20 { padding-top: 20rpx; }
.pt-24 { padding-top: 24rpx; }
.pb-16 { padding-bottom: 16rpx; }
.pb-20 { padding-bottom: 20rpx; }
.pb-24 { padding-bottom: 24rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

/* ============================================
   图标容器
   ============================================ */
.icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #E8F4FB;
  display: flex;
  justify-content: center;
  align-items: center;
}

.icon-wrapper-primary {
  background: #4A9ECC;
  box-shadow: 0 4rpx 12rpx rgba(74, 158, 204, 0.35);
}

/* ============================================
   标签/徽章
   ============================================ */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary { background: #E8F4FB; color: #4A9ECC; }
.tag-accent { background: #4A9ECC; color: #FFFFFF; }
.tag-success { background: #E6F4ED; color: #3A7A55; }

/* ============================================
   分割线
   ============================================ */
.divider {
  height: 1rpx;
  background: #DFF0FA;
  margin: 24rpx 0;
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #A0B4C5;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.5;
  margin-bottom: 24rpx;
}
