.activities-page { min-height: 100vh; background: #F0F7FF; }

.page-header {
  background: #4A9ECC;
  padding: 60rpx 32rpx 48rpx;
  text-align: center;
}

.header-title { font-size: 42rpx; font-weight: 700; color: #fff; margin-bottom: 10rpx; }
.header-desc { font-size: 26rpx; color: rgba(255,255,255,0.88); }

.activity-list { padding: 20rpx 24rpx; }

.activity-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(74,158,204,0.1);
}

.activity-card:active { transform: scale(0.98); }

.activity-cover { width: 100%; height: 320rpx; }

.activity-info { padding: 24rpx; }

.activity-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2E3D;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.activity-status {
  display: inline-block;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.activity-status.active { background: #E8F4FB; color: #4A9ECC; }
.activity-status.upcoming { background: #FEF8E7; color: #C08000; }

.activity-time {
  font-size: 26rpx;
  color: #6A8099;
  margin-bottom: 8rpx;
}

.activity-desc {
  font-size: 24rpx;
  color: #8899AA;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #A0B4C5;
  font-size: 28rpx;
}
