/* ============================================
   抽奖页 - Claymorphism 蓝紫色系
   ============================================ */

.lottery-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #6366F1 0%, #8B5CF6 35%, #EEF2FF 35%);
  padding-bottom: 40rpx;
}

/* ============================================
   用户信息栏
   ============================================ */
.user-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}

.chances-info {
  display: flex;
  align-items: baseline;
}

.chances-label {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-right: 12rpx;
}

.chances-num {
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.share-btn {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  padding: 18rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow:
    4rpx 4rpx 12rpx rgba(99, 102, 241, 0.3),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.2);
  transition: all 200ms ease-out;
}

.share-btn:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.35);
}

/* ============================================
   转盘容器 - Claymorphism 效果
   ============================================ */
.wheel-container {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin: 0 auto 40rpx;
}

.wheel-wrapper {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFFFFF, #F5F3FF);
  box-shadow:
    16rpx 16rpx 40rpx rgba(99, 102, 241, 0.25),
    -8rpx -8rpx 30rpx rgba(255, 255, 255, 0.9),
    inset 0 0 0 8rpx rgba(99, 102, 241, 0.1);
  position: relative;
}

.wheel-item {
  position: absolute;
  width: 50%;
  height: 50%;
  left: 50%;
  top: 0;
  transform-origin: 0% 100%;
}

.prize-content {
  position: absolute;
  left: 20rpx;
  top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prize-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 12rpx;
  filter: drop-shadow(2rpx 2rpx 4rpx rgba(99, 102, 241, 0.3));
}

.prize-name {
  font-size: 20rpx;
  color: #4B5563;
  max-width: 100rpx;
  text-align: center;
  font-weight: 500;
}

/* 转盘指针 - Claymorphism */
.wheel-pointer {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 150rpx;
  height: 150rpx;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow:
    8rpx 8rpx 24rpx rgba(99, 102, 241, 0.4),
    -4rpx -4rpx 16rpx rgba(139, 92, 246, 0.2),
    inset 0 0 0 4rpx rgba(255, 255, 255, 0.2);
  z-index: 10;
  transition: all 150ms ease-out;
}

.wheel-pointer:active {
  transform: translate(-50%, -50%) scale(0.95);
}

.wheel-pointer::before {
  content: '';
  position: absolute;
  top: -32rpx;
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 44rpx solid #6366F1;
  filter: drop-shadow(0 -4rpx 8rpx rgba(99, 102, 241, 0.3));
}

/* ============================================
   奖品说明卡片
   ============================================ */
.prizes-info {
  margin: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow:
    8rpx 8rpx 24rpx rgba(99, 102, 241, 0.12),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E1B4B;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #6366F1, #8B5CF6);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.prize-list {
  display: flex;
  flex-wrap: wrap;
}

.prize-item {
  display: flex;
  align-items: center;
  width: 50%;
  padding: 20rpx 0;
}

.prize-icon-small {
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
  padding: 8rpx;
  border-radius: 12rpx;
}

.prize-name-text {
  flex: 1;
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.prize-prob {
  font-size: 24rpx;
  color: #8B5CF6;
  font-weight: 500;
}

/* ============================================
   中奖弹窗 - Claymorphism
   ============================================ */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(30, 27, 75, 0.6);
  backdrop-filter: blur(8rpx);
}

.modal-content {
  position: relative;
  width: 580rpx;
  background: linear-gradient(145deg, #FFFFFF, #F5F3FF);
  border-radius: 32rpx;
  padding: 56rpx 44rpx;
  text-align: center;
  animation: modalIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow:
    16rpx 16rpx 48rpx rgba(99, 102, 241, 0.25),
    -8rpx -8rpx 32rpx rgba(255, 255, 255, 0.8);
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.7) translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #6366F1, #A855F7);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 32rpx;
}

.result-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(4rpx 4rpx 12rpx rgba(99, 102, 241, 0.3));
}

.result-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E1B4B;
  margin-bottom: 24rpx;
}

.result-claim, .result-points {
  background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  box-shadow:
    inset 2rpx 2rpx 6rpx rgba(99, 102, 241, 0.1),
    inset -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.8);
}

.result-claim text, .result-points text {
  display: block;
  font-size: 26rpx;
  color: #4B5563;
}

.claim-tip {
  color: #8B5CF6 !important;
  margin-top: 12rpx;
  font-weight: 600;
}

.modal-content .btn-primary {
  width: 100%;
  margin-top: 24rpx;
}
