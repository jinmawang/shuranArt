/* ============================================
   抽奖页 - 晴空蓝·明朗欢快
   ============================================ */

.lottery-page {
  min-height: 100vh;
  background: #F0F7FF;
  padding-bottom: 40rpx;
}

/* 活动信息栏 */
.activity-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #4A9ECC;
}

.activity-name { color: rgba(255,255,255,0.95); font-size: 28rpx; font-weight: 600; flex: 1; }

.activity-status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.activity-status.active { background: rgba(255,255,255,0.25); color: #fff; }
.activity-status.upcoming { background: rgba(245,200,66,0.9); color: #7A4F00; }

/* 用户信息栏 */
.user-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background: #4A9ECC;
}

.chances-info { display: flex; align-items: baseline; }
.chances-label { color: rgba(255,255,255,0.85); font-size: 26rpx; margin-right: 10rpx; }
.chances-num { color: #fff; font-size: 56rpx; font-weight: 700; }

.share-btn {
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255,255,255,0.4);
  transition: all 200ms ease-out;
}

.share-btn:active { transform: scale(0.96); background: rgba(255,255,255,0.3); }
.share-btn.disabled { opacity: 0.45; pointer-events: none; }

/* 抽奖进度条 */
.lottery-progress { flex: 1; margin: 0 20rpx; }
.progress-text { color: rgba(255,255,255,0.9); font-size: 24rpx; display: block; margin-bottom: 8rpx; }
.progress-bar { height: 10rpx; background: rgba(255,255,255,0.3); border-radius: 5rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #F5C842; border-radius: 5rpx; transition: width 0.3s ease; }

/* 保底提示 */
.guarantee-tip {
  margin: 0 24rpx 4rpx;
  padding: 14rpx 24rpx;
  background: #FEF8E7;
  border-radius: 0 0 12rpx 12rpx;
  text-align: center;
  border: 1rpx solid #F5C842;
  border-top: none;
}

.guarantee-tip text { color: #A07010; font-size: 26rpx; font-weight: 500; }

/* 转盘容器 */
.wheel-container { position: relative; width: 580rpx; height: 580rpx; margin: 32rpx auto; }

.wheel-wrapper {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(74, 158, 204, 0.15), 0 0 0 10rpx rgba(74, 158, 204, 0.1);
  position: relative;
}

.wheel-item {
  position: absolute;
  width: 50%;
  height: 50%;
  left: 50%;
  top: 0;
  transform-origin: 0% 100%;
}

.prize-content {
  position: absolute;
  left: 20rpx;
  top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prize-icon { width: 60rpx; height: 60rpx; margin-bottom: 10rpx; }
.prize-name { font-size: 20rpx; color: #4A5E6D; max-width: 100rpx; text-align: center; font-weight: 500; }

/* 转盘指针 */
.wheel-pointer {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 148rpx;
  height: 148rpx;
  background: #4A9ECC;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(74, 158, 204, 0.45);
  z-index: 10;
  transition: all 150ms ease-out;
  border: 6rpx solid #fff;
}

.wheel-pointer:active { transform: translate(-50%, -50%) scale(0.95); }

.wheel-pointer::before {
  content: '';
  position: absolute;
  top: -28rpx;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 36rpx solid #4A9ECC;
}

.wheel-pointer.disabled { background: #C8C8C8; box-shadow: none; pointer-events: none; }
.wheel-pointer.disabled::before { border-bottom-color: #C8C8C8; }
.wheel-pointer.disabled text { font-size: 24rpx; }

/* 奖品说明卡片 */
.prizes-info {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(74, 158, 204, 0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2E3D;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: #4A9ECC;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-header .section-title { margin-bottom: 0; }

.rules-btn {
  font-size: 24rpx;
  color: #4A9ECC;
  padding: 8rpx 18rpx;
  background: #E8F4FB;
  border-radius: 20rpx;
  font-weight: 500;
}

.rules-btn:active { background: #D0EAFA; }

.prize-list { display: flex; flex-wrap: wrap; }

.prize-item { display: flex; align-items: center; width: 50%; padding: 18rpx 0; }

.prize-icon-small {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  background: #E8F4FB;
  padding: 8rpx;
  border-radius: 10rpx;
}

.prize-name-text { flex: 1; font-size: 26rpx; color: #1A2E3D; font-weight: 500; }
.prize-prob { font-size: 24rpx; color: #4A9ECC; font-weight: 500; }
.prize-level { margin-left: auto; margin-right: 10rpx; }

.level-tag { font-size: 20rpx; padding: 5rpx 12rpx; border-radius: 8rpx; font-weight: 600; }
.level-tag.first { background: #FEF8E7; color: #C08000; }
.level-tag.second { background: #E8F4FB; color: #4A9ECC; }

.guarantee-info { margin-top: 20rpx; padding: 18rpx; background: #FEF8E7; border-radius: 10rpx; }
.guarantee-info text { font-size: 24rpx; color: #A07010; line-height: 1.6; }

/* 弹窗 */
.result-modal, .rules-modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-mask {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(26, 46, 61, 0.5);
}

.modal-content {
  position: relative;
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  animation: modalIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 16rpx 48rpx rgba(74, 158, 204, 0.2);
}

@keyframes modalIn {
  from { opacity: 0; transform: scale(0.75) translateY(30rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-title { font-size: 38rpx; font-weight: 700; color: #4A9ECC; margin-bottom: 28rpx; }
.result-icon { width: 160rpx; height: 160rpx; margin-bottom: 20rpx; }
.result-name { font-size: 32rpx; font-weight: 700; color: #1A2E3D; margin-bottom: 20rpx; }
.result-level { margin-bottom: 16rpx; }

.level-badge { display: inline-block; font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 24rpx; font-weight: 600; }
.level-badge.first { background: #FEF8E7; color: #C08000; }
.level-badge.second { background: #E8F4FB; color: #4A9ECC; }

.result-count { font-size: 24rpx; color: #6A8099; margin-bottom: 20rpx; }

.result-claim, .result-points {
  background: #F0F7FF;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.result-claim text, .result-points text { display: block; font-size: 26rpx; color: #4A5E6D; }
.claim-tip { color: #4A9ECC !important; margin-top: 10rpx; font-weight: 600; }
.modal-content .btn-primary { width: 100%; margin-top: 20rpx; }

/* 规则弹窗 */
.rules-content { max-height: 80vh; overflow-y: auto; }
.rules-list { text-align: left; margin-bottom: 28rpx; }

.rule-item { display: flex; align-items: flex-start; margin-bottom: 20rpx; }

.rule-num {
  width: 44rpx;
  height: 44rpx;
  min-width: 44rpx;
  background: #4A9ECC;
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.rule-text { flex: 1; font-size: 28rpx; color: #4A5E6D; line-height: 1.6; }
