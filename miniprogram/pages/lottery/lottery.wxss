.lottery-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ff6b35 0%, #ff8f65 50%, #f5f5f5 50%);
  padding-bottom: 40rpx;
}

/* 用户信息栏 */
.user-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.chances-info {
  display: flex;
  align-items: baseline;
}

.chances-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  margin-right: 10rpx;
}

.chances-num {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}

.share-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 16rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* 转盘容器 */
.wheel-container {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  margin: 0 auto 40rpx;
}

.wheel-wrapper {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  position: relative;
}

.wheel-item {
  position: absolute;
  width: 50%;
  height: 50%;
  left: 50%;
  top: 0;
  transform-origin: 0% 100%;
}

.prize-content {
  position: absolute;
  left: 20rpx;
  top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prize-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.prize-name {
  font-size: 20rpx;
  color: #333;
  max-width: 100rpx;
  text-align: center;
}

.wheel-pointer {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(180deg, #ff6b35, #e65100);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
  z-index: 10;
}

.wheel-pointer::before {
  content: '';
  position: absolute;
  top: -30rpx;
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 40rpx solid #ff6b35;
}

/* 奖品说明卡片 */
.prizes-info {
  margin: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.prize-list {
  display: flex;
  flex-wrap: wrap;
}

.prize-item {
  display: flex;
  align-items: center;
  width: 50%;
  padding: 16rpx 0;
}

.prize-icon-small {
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
}

.prize-name-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.prize-prob {
  font-size: 24rpx;
  color: #999;
}

/* 中奖弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 30rpx;
}

.result-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}

.result-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.result-claim, .result-points {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.result-claim text, .result-points text {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.claim-tip {
  color: #ff6b35 !important;
  margin-top: 10rpx;
}

.modal-content .btn-primary {
  width: 100%;
  margin-top: 20rpx;
}
