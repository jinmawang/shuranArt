<view class="lottery-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px;">幸运抽奖</view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>

  <!-- 活动信息 -->
  <view class="activity-bar" wx:if="{{activity}}">
    <text class="activity-name">{{activity.title}}</text>
    <view class="activity-status {{activity.started ? 'active' : 'upcoming'}}">
      {{activity.started ? '进行中' : '即将开始'}}
    </view>
  </view>

  <!-- 用户信息 -->
  <view class="user-bar">
    <view class="chances-info">
      <text class="chances-label">剩余抽奖次数</text>
      <text class="chances-num">{{userInfo.lotteryChances || 0}}</text>
    </view>
    <view class="share-btn {{canShare ? '' : 'disabled'}}" bindtap="goToShare">
      <text>分享获取机会</text>
    </view>
  </view>

  <!-- 转盘区域 -->
  <view class="wheel-container">
    <view class="wheel-wrapper" style="transform: rotate({{rotateAngle}}deg); transition: transform {{isSpinning ? '4s' : '0s'}} cubic-bezier(0.17, 0.67, 0.12, 0.99);">
      <view class="wheel-item" wx:for="{{prizes}}" wx:key="id" style="transform: rotate({{index * (360 / prizes.length)}}deg);">
        <view class="prize-content" style="transform: rotate({{180 / prizes.length}}deg);">
          <image src="{{item.icon || '/images/prize-default.png'}}" class="prize-icon"/>
          <text class="prize-name">{{item.name}}</text>
        </view>
      </view>
    </view>
    <view class="wheel-pointer {{isSpinning ? 'disabled' : ''}}" bindtap="startLottery">
      <text wx:if="{{!activity || !activity.started}}">未开始</text>
      <text wx:else>抽奖</text>
    </view>
  </view>

  <!-- 奖品说明 -->
  <view class="card prizes-info">
    <view class="section-header">
      <view class="section-title">奖品说明</view>
      <view class="rules-btn" bindtap="showRulesModal">
        <text>抽奖规则</text>
      </view>
    </view>
    <view class="prize-list">
      <view class="prize-item" wx:for="{{prizes}}" wx:key="id">
        <image src="{{item.icon || '/images/prize-default.png'}}" class="prize-icon-small"/>
        <text class="prize-name-text">{{item.name}}</text>
        <view class="prize-level" wx:if="{{item.level <= 2}}">
          <text class="level-tag {{item.level === 1 ? 'first' : 'second'}}">{{item.level === 1 ? '一等奖' : '二等奖'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 规则弹窗 -->
  <view class="rules-modal" wx:if="{{showRules}}">
    <view class="modal-mask" bindtap="closeRulesModal"></view>
    <view class="modal-content rules-content">
      <view class="modal-title">抽奖规则</view>
      <view class="rules-list">
        <view class="rule-item">
          <text class="rule-num">1</text>
          <text class="rule-text">进入活动详情页可获得1次抽奖机会</text>
        </view>
        <view class="rule-item">
          <text class="rule-num">2</text>
          <text class="rule-text">分享活动给好友，好友点击后您可获得1次抽奖机会</text>
        </view>
        <view class="rule-item">
          <text class="rule-num">3</text>
          <text class="rule-text">每个活动最多可获得6次抽奖机会</text>
        </view>
        <view class="rule-item">
          <text class="rule-num">4</text>
          <text class="rule-text">每8次抽奖必中一或二等奖</text>
        </view>
        <view class="rule-item">
          <text class="rule-num">5</text>
          <text class="rule-text">抽中实物奖品请到店凭兑换码领取</text>
        </view>
      </view>
      <button class="btn-primary" bindtap="closeRulesModal">我知道了</button>
    </view>
  </view>

  <!-- 中奖弹窗 -->
  <view class="result-modal" wx:if="{{showResult}}">
    <view class="modal-mask" bindtap="closeResult"></view>
    <view class="modal-content">
      <view class="modal-title">
        {{resultPrize.isGuarantee ? '保底大奖' : '恭喜您'}}
      </view>
      <view class="result-level" wx:if="{{resultPrize.prizeLevel <= 2}}">
        <text class="level-badge {{resultPrize.prizeLevel === 1 ? 'first' : 'second'}}">
          {{resultPrize.prizeLevel === 1 ? '一等奖' : '二等奖'}}
        </text>
      </view>
      <image src="{{resultPrize.icon || '/images/prize-default.png'}}" class="result-icon"/>
      <view class="result-name">{{resultPrize.prizeName}}</view>
      <view class="result-count" wx:if="{{resultPrize.isGuarantee}}">保底中奖！</view>
      <view class="result-claim" wx:if="{{resultPrize.needClaim}}">
        <text>兑换码：{{resultPrize.claimCode}}</text>
        <text class="claim-tip">请到店出示兑换码领取奖品</text>
      </view>
      <view class="result-points" wx:if="{{resultPrize.prizeType === 'points'}}">
        <text>已自动发放到您的账户</text>
      </view>
      <button class="btn-primary" bindtap="closeResult">知道了</button>
    </view>
  </view>
</view>
