/* ============================================
   师资页 - Claymorphism 蓝紫色系
   ============================================ */

.teachers-page {
  min-height: 100vh;
}

/* ============================================
   页面头部
   ============================================ */
.page-header {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #A855F7 100%);
  padding: 72rpx 32rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  animation: shimmer 8s infinite linear;
}

@keyframes shimmer {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.header-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  position: relative;
}

/* ============================================
   教师列表
   ============================================ */
.teacher-list {
  padding: 24rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 1;
}

/* ============================================
   教师卡片 - Claymorphism
   ============================================ */
.teacher-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.15),
    -5rpx -5rpx 20rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
  transition: all 250ms ease-out;
}

.teacher-card:active {
  transform: scale(0.98);
  box-shadow:
    6rpx 6rpx 20rpx rgba(99, 102, 241, 0.2),
    -3rpx -3rpx 12rpx rgba(255, 255, 255, 0.7);
}

.teacher-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  float: left;
  margin-right: 28rpx;
  margin-bottom: 24rpx;
  box-shadow:
    6rpx 6rpx 16rpx rgba(99, 102, 241, 0.2),
    -3rpx -3rpx 10rpx rgba(255, 255, 255, 0.8);
  border: 4rpx solid rgba(99, 102, 241, 0.15);
}

.teacher-info {
  overflow: hidden;
  min-height: 160rpx;
}

.teacher-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E1B4B;
  margin-bottom: 10rpx;
}

.teacher-title {
  font-size: 26rpx;
  color: #8B5CF6;
  margin-bottom: 14rpx;
  font-weight: 600;
  display: inline-block;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
  border-radius: 20rpx;
}

.teacher-intro {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
}

/* ============================================
   教师作品
   ============================================ */
.teacher-works {
  clear: both;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(99, 102, 241, 0.1);
}

.works-title {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 18rpx;
  font-weight: 500;
}

.works-scroll {
  white-space: nowrap;
}

.work-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
  display: inline-block;
  box-shadow:
    4rpx 4rpx 12rpx rgba(99, 102, 241, 0.15),
    -2rpx -2rpx 8rpx rgba(255, 255, 255, 0.6);
}

/* ============================================
   空状态
   ============================================ */
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}
