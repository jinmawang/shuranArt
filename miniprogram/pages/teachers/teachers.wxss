/* ============================================
   师资页 - 晴空蓝·明朗欢快
   ============================================ */

.teachers-page { min-height: 100vh; background: #F0F7FF; }

.page-header {
  background: #4A9ECC;
  padding: 60rpx 32rpx 48rpx;
  text-align: center;
}

.header-title { font-size: 42rpx; font-weight: 700; color: #fff; margin-bottom: 10rpx; }
.header-desc { font-size: 26rpx; color: rgba(255,255,255,0.88); }

.teacher-list { padding: 20rpx 24rpx 24rpx; }

.teacher-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 16rpx rgba(74,158,204,0.1);
  transition: all 200ms ease-out;
}

.teacher-card:active { transform: scale(0.98); }

.teacher-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  float: left;
  margin-right: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 3rpx 12rpx rgba(74,158,204,0.15);
  border: 3rpx solid #DFF0FA;
}

.teacher-info { overflow: hidden; min-height: 150rpx; }
.teacher-name { font-size: 34rpx; font-weight: 700; color: #1A2E3D; margin-bottom: 10rpx; }

.teacher-title {
  font-size: 24rpx;
  color: #4A9ECC;
  margin-bottom: 12rpx;
  font-weight: 500;
  display: inline-block;
  padding: 5rpx 14rpx;
  background: #E8F4FB;
  border-radius: 20rpx;
}

.teacher-intro { font-size: 26rpx; color: #6A8099; line-height: 1.7; }

.teacher-works {
  clear: both;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEF6FC;
}

.works-title { font-size: 26rpx; color: #A0B4C5; margin-bottom: 14rpx; font-weight: 500; }
.works-scroll { white-space: nowrap; }

.work-img {
  width: 190rpx;
  height: 190rpx;
  border-radius: 12rpx;
  margin-right: 14rpx;
  display: inline-block;
  box-shadow: 0 2rpx 10rpx rgba(74,158,204,0.1);
}

.empty-tip { text-align: center; padding: 120rpx 0; color: #A0B4C5; font-size: 28rpx; }
