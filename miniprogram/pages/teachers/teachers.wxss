.teachers-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.page-header {
  background: linear-gradient(135deg, #ff6b35, #ff8f65);
  padding: 60rpx 30rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.teacher-list {
  padding: 20rpx;
}

.teacher-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.teacher-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  float: left;
  margin-right: 24rpx;
  margin-bottom: 20rpx;
}

.teacher-info {
  overflow: hidden;
  min-height: 160rpx;
}

.teacher-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.teacher-title {
  font-size: 26rpx;
  color: #ff6b35;
  margin-bottom: 12rpx;
}

.teacher-intro {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.teacher-works {
  clear: both;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.works-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.works-scroll {
  white-space: nowrap;
}

.work-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: inline-block;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
