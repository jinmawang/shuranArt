<view class="config-page">
  <view class="form-section">
    <view class="section-title">基本信息</view>

    <view class="form-item">
      <text class="label">画室名称</text>
      <input class="input" value="{{config.studio_name}}" data-key="studio_name" bindinput="onInput" placeholder="请输入画室名称"/>
    </view>

    <view class="form-item">
      <text class="label">宣传语</text>
      <input class="input" value="{{config.studio_slogan}}" data-key="studio_slogan" bindinput="onInput" placeholder="请输入宣传语"/>
    </view>

    <view class="form-item">
      <text class="label">画室简介</text>
      <textarea class="textarea" value="{{config.studio_description}}" data-key="studio_description" bindinput="onInput" placeholder="请输入画室简介"/>
    </view>

    <view class="form-item">
      <text class="label">画室详细介绍</text>
      <textarea class="textarea tall" value="{{config.studio_intro}}" data-key="studio_intro" bindinput="onInput" placeholder="请输入详细的画室介绍内容"/>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">画室地址</view>

    <view class="form-item">
      <text class="label">地址</text>
      <view class="location-picker" bindtap="chooseLocation">
        <text class="location-text" wx:if="{{config.studio_address}}">{{config.studio_address}}</text>
        <text class="location-placeholder" wx:else>点击选择画室地址</text>
        <text class="location-icon">📍</text>
      </view>
    </view>

    <view class="form-item" wx:if="{{config.studio_latitude && config.studio_longitude}}">
      <text class="label">坐标信息</text>
      <view class="coord-info">
        <text>纬度: {{config.studio_latitude}}</text>
        <text>经度: {{config.studio_longitude}}</text>
      </view>
    </view>

    <view class="map-preview" wx:if="{{config.studio_latitude && config.studio_longitude}}">
      <map class="preview-map"
           latitude="{{config.studio_latitude}}"
           longitude="{{config.studio_longitude}}"
           markers="{{markers}}"
           scale="16"/>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">联系方式</view>

    <view class="form-item">
      <text class="label">老师微信号</text>
      <input class="input" value="{{config.studio_wechat_id}}" data-key="studio_wechat_id" bindinput="onInput" placeholder="请输入老师的微信号"/>
    </view>

    <view class="form-item">
      <text class="label">老师微信二维码</text>
      <view class="image-upload" bindtap="chooseQrcode">
        <image wx:if="{{config.studio_qrcode}}" src="{{config.studio_qrcode}}" mode="aspectFit" class="upload-preview qrcode"/>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">+</text>
          <text class="upload-text">上传二维码</text>
        </view>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="section-title">分享设置</view>

    <view class="form-item">
      <text class="label">分享标题模板</text>
      <input class="input" value="{{config.share_title_template}}" data-key="share_title_template" bindinput="onInput" placeholder="使用{activity_title}作为活动名称占位符"/>
    </view>

    <view class="form-item">
      <text class="label">分享描述模板</text>
      <input class="input" value="{{config.share_desc_template}}" data-key="share_desc_template" bindinput="onInput" placeholder="请输入分享描述"/>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn-primary" bindtap="saveConfig">保存配置</button>
  </view>
</view>
