<view class="list-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      老师管理
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>
  <view class="list-header">
    <view class="add-btn" bindtap="addTeacher">
      <text>+ 添加</text>
    </view>
  </view>

  <view class="list-content">
    <view class="list-item" wx:for="{{teachers}}" wx:key="id">
      <image src="{{item.avatar || '/images/default-avatar.png'}}" class="item-avatar"/>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-title">{{item.title}}</view>
        <view class="item-works-count" wx:if="{{item.works && item.works.length}}">作品 {{item.works.length}} 张</view>
      </view>
      <view class="item-actions">
        <view class="action-btn edit" bindtap="editTeacher" data-item="{{item}}">编辑</view>
        <view class="action-btn delete" bindtap="deleteTeacher" data-id="{{item.id}}">删除</view>
      </view>
    </view>
    <view wx:if="{{teachers.length === 0}}" class="empty-tip">暂无数据</view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-title">{{editing.id ? '编辑老师' : '添加老师'}}</view>
      <view class="form-item">
        <text class="label">姓名 *</text>
        <input class="input" value="{{editing.name}}" data-key="name" bindinput="onInput" placeholder="请输入姓名"/>
      </view>
      <view class="form-item">
        <text class="label">职称</text>
        <input class="input" value="{{editing.title}}" data-key="title" bindinput="onInput" placeholder="如：专业美术教师"/>
      </view>
      <view class="form-item">
        <text class="label">简介</text>
        <textarea class="textarea" value="{{editing.intro}}" data-key="intro" bindinput="onInput" placeholder="请输入老师简介"/>
      </view>
      <view class="form-item">
        <text class="label">微信号</text>
        <input class="input" value="{{editing.wechatId}}" data-key="wechatId" bindinput="onInput" placeholder="请输入老师微信号（学员可一键复制）"/>
      </view>
      <view class="form-item">
        <text class="label">头像</text>
        <view class="image-picker" bindtap="chooseAvatar">
          <image wx:if="{{editing.avatar}}" src="{{editing.avatar}}" class="picker-preview" mode="aspectFill"/>
          <view wx:else class="picker-placeholder">
            <text class="picker-plus">+</text>
            <text class="picker-tip">上传头像</text>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="label">代表作品（最多9张）</text>
        <view class="works-picker">
          <view class="works-item" wx:for="{{editing.works}}" wx:key="index">
            <image src="{{item}}" mode="aspectFill" class="works-preview"/>
            <view class="works-delete" bindtap="removeWork" data-index="{{index}}">x</view>
          </view>
          <view class="works-add" bindtap="chooseWork" wx:if="{{!editing.works || editing.works.length < 9}}">
            <text class="picker-plus">+</text>
            <text class="picker-tip">添加</text>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="label">排序</text>
        <input class="input" type="number" value="{{editing.sortOrder}}" data-key="sortOrder" bindinput="onInput" placeholder="数字越小越靠前"/>
      </view>
      <view class="modal-actions">
        <button class="btn-cancel" bindtap="closeModal">取消</button>
        <button class="btn-confirm" bindtap="saveTeacher">保存</button>
      </view>
    </view>
  </view>
</view>
