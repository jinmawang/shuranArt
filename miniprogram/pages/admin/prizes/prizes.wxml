<view class="list-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      奖品管理
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>
  <view class="list-header">
    <view class="add-btn" bindtap="addPrize">
      <text>+ 添加</text>
    </view>
  </view>

  <view class="list-content">
    <view class="list-item" wx:for="{{prizes}}" wx:key="id">
      <image src="{{item.icon || '/images/prize-default.png'}}" class="item-icon"/>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">
          <text>概率: {{item.probability}}%</text>
          <text>库存: {{item.stock === -1 ? '无限' : item.stock}}</text>
        </view>
        <view class="item-type">类型: {{typeMap[item.type] || item.type}}</view>
      </view>
      <view class="item-actions">
        <view class="action-btn edit" bindtap="editPrize" data-item="{{item}}">编辑</view>
        <view class="action-btn delete" bindtap="deletePrize" data-id="{{item.id}}">删除</view>
      </view>
    </view>
    <view wx:if="{{prizes.length === 0}}" class="empty-tip">暂无数据</view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-title">{{editing.id ? '编辑奖品' : '添加奖品'}}</view>
      <view class="form-item">
        <text class="label">奖品名称</text>
        <input class="input" value="{{editing.name}}" data-key="name" bindinput="onInput" placeholder="请输入奖品名称"/>
      </view>
      <view class="form-item">
        <text class="label">奖品类型</text>
        <picker range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="input picker">{{typeOptions[typeIndex].label}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="label">奖品价值 (积分类型为积分数，其他为1)</text>
        <input class="input" type="number" value="{{editing.value}}" data-key="value" bindinput="onInput" placeholder="请输入价值"/>
      </view>
      <view class="form-item">
        <text class="label">中奖概率 (0-100)</text>
        <input class="input" type="number" value="{{editing.probability}}" data-key="probability" bindinput="onInput" placeholder="请输入概率百分比"/>
      </view>
      <view class="form-item">
        <text class="label">库存 (-1为无限)</text>
        <input class="input" type="number" value="{{editing.stock}}" data-key="stock" bindinput="onInput" placeholder="请输入库存数量"/>
      </view>
      <view class="form-item">
        <text class="label">奖品图标</text>
        <view class="image-picker" bindtap="chooseIcon">
          <image wx:if="{{editing.icon}}" src="{{editing.icon}}" class="picker-preview" mode="aspectFill"/>
          <view wx:else class="picker-placeholder">
            <text class="picker-plus">+</text>
            <text class="picker-tip">点击上传图片</text>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="label">需要到店领取</text>
        <switch checked="{{editing.needClaim === 1}}" bindchange="onNeedClaimChange"/>
      </view>
      <view class="form-item">
        <text class="label">启用状态</text>
        <switch checked="{{editing.status === 1}}" bindchange="onStatusChange"/>
      </view>
      <view class="modal-actions">
        <button class="btn-cancel" bindtap="closeModal">取消</button>
        <button class="btn-confirm" bindtap="savePrize">保存</button>
      </view>
    </view>
  </view>
</view>
