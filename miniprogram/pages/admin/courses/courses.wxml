<view class="list-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      课程管理
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>
  <view class="list-header">
    <view class="add-btn" bindtap="addCourse">
      <text>+ 添加</text>
    </view>
  </view>

  <view class="list-content">
    <view class="list-item" wx:for="{{courses}}" wx:key="id">
      <image src="{{item.coverImg || '/images/default-course.png'}}" class="item-cover"/>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">
          <text class="item-category">{{item.category}}</text>
          <text class="item-suitable" wx:if="{{item.suitableFor}}">{{item.suitableFor}}</text>
        </view>
        <view class="item-status {{item.status === 1 ? 'status-on' : 'status-off'}}">
          {{item.status === 1 ? '已上架' : '已下架'}}
        </view>
      </view>
      <view class="item-actions">
        <view class="action-btn toggle" bindtap="toggleStatus" data-item="{{item}}">
          {{item.status === 1 ? '下架' : '上架'}}
        </view>
        <view class="action-btn edit" bindtap="editCourse" data-item="{{item}}">编辑</view>
        <view class="action-btn delete" bindtap="deleteCourse" data-id="{{item.id}}">删除</view>
      </view>
    </view>
    <view wx:if="{{courses.length === 0}}" class="empty-tip">暂无数据</view>
  </view>

  <!-- 编辑弹窗 -->
  <view class="modal" wx:if="{{showModal}}">
    <view class="modal-mask" bindtap="closeModal"></view>
    <view class="modal-content">
      <view class="modal-title">{{editing.id ? '编辑课程' : '添加课程'}}</view>
      <view class="form-item">
        <text class="label">课程名称 *</text>
        <input class="input" value="{{editing.name}}" data-key="name" bindinput="onInput" placeholder="如：创意儿童画、少儿素描"/>
      </view>
      <view class="form-item">
        <text class="label">课程分类 *</text>
        <input class="input" value="{{editing.category}}" data-key="category" bindinput="onInput" placeholder="如：素描/水彩/油画/国画/手工"/>
      </view>
      <view class="form-item">
        <text class="label">适合年龄 *</text>
        <input class="input" value="{{editing.suitableFor}}" data-key="suitableFor" bindinput="onInput" placeholder="如：4-6岁、7-12岁"/>
      </view>
      <view class="form-item">
        <text class="label">封面图片</text>
        <view class="image-picker" bindtap="chooseCoverImage">
          <image wx:if="{{editing.coverImg}}" src="{{editing.coverImg}}" class="picker-preview" mode="aspectFill"/>
          <view wx:else class="picker-placeholder">
            <text class="picker-plus">+</text>
            <text class="picker-tip">点击上传图片</text>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="label">课程简介</text>
        <textarea class="textarea" value="{{editing.description}}" data-key="description" bindinput="onInput" placeholder="请输入课程介绍，如教学内容、特色等"/>
      </view>
      <view class="form-item">
        <text class="label">排序</text>
        <input class="input" type="number" value="{{editing.sortOrder}}" data-key="sortOrder" bindinput="onInput" placeholder="数字越小越靠前"/>
      </view>
      <view class="modal-actions">
        <button class="btn-cancel" bindtap="closeModal">取消</button>
        <button class="btn-confirm" bindtap="saveCourse">保存</button>
      </view>
    </view>
  </view>
</view>
