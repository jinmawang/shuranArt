.list-page { min-height: 100vh; background: #f5f5f5; }

.list-header { display: flex; justify-content: flex-end; padding: 30rpx; background: #fff; }
.add-btn { background: linear-gradient(135deg, #6366F1, #8B5CF6); color: #fff; padding: 12rpx 24rpx; border-radius: 30rpx; font-size: 26rpx; }

.list-content { padding: 20rpx; }
.list-item { display: flex; align-items: center; background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.item-cover { width: 160rpx; height: 120rpx; border-radius: 8rpx; margin-right: 20rpx; }
.item-info { flex: 1; }
.item-name { font-size: 30rpx; font-weight: 500; color: #333; }
.item-detail { font-size: 24rpx; color: #6366f1; margin-top: 6rpx; }
.item-time { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.item-status { display: inline-block; font-size: 22rpx; color: #999; background: #f5f5f5; padding: 4rpx 12rpx; border-radius: 20rpx; margin-top: 8rpx; }
.item-status.active { color: #4caf50; background: #e8f5e9; }

.item-actions { display: flex; flex-direction: column; gap: 10rpx; }
.action-btn { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; text-align: center; }
.action-btn.view { background: #f3e8ff; color: #7c3aed; }
.action-btn.edit { background: #e3f2fd; color: #1976d2; }
.action-btn.delete { background: #ffebee; color: #e53935; }

.empty-tip { text-align: center; padding: 80rpx 0; color: #999; }

/* 成团名单 */
.teams-content { padding: 20rpx; }
.team-section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.team-header-admin { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.team-label { font-size: 30rpx; font-weight: 600; color: #333; }
.team-status-tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 20rpx; }
.team-status-tag.success { background: #e8f5e9; color: #4caf50; }
.team-status-tag.pending { background: #fff3e0; color: #ff9800; }
.team-status-tag.expired { background: #f5f5f5; color: #999; }
.team-count-label { font-size: 24rpx; color: #666; }
.team-time { font-size: 22rpx; color: #999; }

.member-list { border-top: 1rpx solid #f0f0f0; padding-top: 16rpx; }
.member-row { display: flex; align-items: center; padding: 12rpx 0; }
.member-avatar-sm { width: 56rpx; height: 56rpx; border-radius: 50%; margin-right: 16rpx; }
.member-info { flex: 1; }
.member-name { font-size: 28rpx; color: #333; display: block; }
.member-phone { font-size: 24rpx; color: #666; display: block; margin-top: 4rpx; }
.member-time { font-size: 22rpx; color: #999; }

/* 弹窗 */
.custom-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: #fff; }
.custom-nav-title { display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600; color: #333; }
.custom-nav-back::before { border-left-color: #333; border-bottom-color: #333; }

.modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; display: flex; justify-content: center; align-items: center; }
.modal-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); }
.modal-content { position: relative; width: 90%; max-height: 80vh; background: #fff; border-radius: 16rpx; padding: 40rpx; }
.modal-title { font-size: 32rpx; font-weight: bold; color: #333; text-align: center; margin-bottom: 30rpx; }
.form-item { margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.input { width: 100%; height: 80rpx; background: #f5f5f5; border-radius: 8rpx; padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box; line-height: 80rpx; }
.input.picker { color: #333; }
.textarea { width: 100%; height: 160rpx; background: #f5f5f5; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.form-divider { font-size: 26rpx; color: #8B5CF6; font-weight: 500; margin: 30rpx 0 20rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid #E0E7FF; }
.image-upload { width: 180rpx; height: 180rpx; border-radius: 12rpx; overflow: hidden; background: #f5f5f5; display: flex; align-items: center; justify-content: center; }
.upload-preview { width: 100%; height: 100%; }
.upload-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #999; font-size: 26rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 30rpx; }
.btn-cancel, .btn-confirm { flex: 1; height: 80rpx; border-radius: 40rpx; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.btn-cancel { background: #f5f5f5; color: #666; }
.btn-confirm { background: linear-gradient(135deg, #6366F1, #8B5CF6); color: #fff; }
