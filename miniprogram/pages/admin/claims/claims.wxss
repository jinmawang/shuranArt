.list-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.list-content {
  padding: 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.item-prize {
  font-size: 26rpx;
  color: #ff6b35;
  margin-top: 4rpx;
}

.item-code {
  font-size: 24rpx;
  color: #6366F1;
  margin-top: 4rpx;
}

.item-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.action-btn.claim {
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

