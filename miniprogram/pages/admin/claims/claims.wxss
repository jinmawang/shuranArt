.list-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.tab-bar {
  display: flex;
  background: #fff;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}
.tab-item.active {
  color: #4A9ECC;
  font-weight: 600;
  border-bottom-color: #4A9ECC;
}

.list-content {
  padding: 20rpx;
}

.points-tip {
  font-size: 24rpx;
  color: #A0B4C5;
  padding: 0 0 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.item-prize {
  font-size: 26rpx;
  color: #ff6b35;
  margin-top: 4rpx;
}

.item-code {
  font-size: 24rpx;
  color: #6366F1;
  margin-top: 4rpx;
}

.item-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.action-btn.claim {
  background: #e8f5e9;
  color: #2e7d32;
}

.action-btn.void {
  background: #f5f5f5;
  color: #999;
}

.action-btn.disabled {
  background: #f5f5f5;
  color: #ccc;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}
