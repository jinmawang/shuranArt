.list-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
}

.add-btn {
  background: #ff6b35;
  color: #fff;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-content {
  padding: 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.super-badge {
  font-size: 20rpx;
  color: #ff6b35;
  background: #fff3e0;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: normal;
}

.item-title {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
}

.action-btn.delete {
  background: #ffebee;
  color: #e53935;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: relative;
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.share-tip {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 16rpx;
}

.share-note {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.share-btn {
  background: #ff6b35 !important;
  color: #fff !important;
  border-radius: 40rpx !important;
  height: 80rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-cancel {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 24rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #6366F1;
}

.custom-nav-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.custom-nav-back {
  position: absolute;
  left: 20rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-nav-back::after {
  content: '<';
  font-size: 36rpx;
  color: #fff;
}
