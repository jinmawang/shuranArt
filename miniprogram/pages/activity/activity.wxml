<view class="activity-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      活动详情
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>
  <image src="{{activity.coverImg || '/images/default-activity.png'}}" mode="aspectFill" class="activity-cover"/>

  <view class="activity-content">
    <view class="activity-header">
      <view class="activity-title">{{activity.title}}</view>
      <!-- 活动状态提示 -->
      <view class="activity-status {{activity.started ? 'active' : 'upcoming'}}" wx:if="{{!activity.ended}}">
        <text wx:if="{{activity.started}}">活动进行中</text>
        <text wx:else>活动即将开始～</text>
      </view>
      <view class="activity-time">
        <image src="/images/icon-time.png" class="time-icon"/>
        <text>{{startDate}} - {{endDate}}</text>
      </view>
    </view>

    <view class="activity-body">
      <view class="section-title">活动详情</view>
      <view class="activity-desc">{{activity.description}}</view>
    </view>

    <view class="activity-rules">
      <view class="section-title">活动规则</view>
      <view class="rules-list">
        <view class="rule-item">1. 进入活动详情页可获得1次抽奖机会</view>
        <view class="rule-item">2. 分享活动给好友，好友点击后可获得抽奖机会</view>
        <view class="rule-item">3. 分享越多，中奖概率越大</view>
        <view class="rule-item">4. 抽中实物奖品请到店凭兑换码领取</view>
      </view>
    </view>

    <!-- 联系老师 -->
    <view class="contact-card" wx:if="{{studioWechatId || studioQrcode}}">
      <view class="section-title">联系老师</view>
      <view class="contact-body">
        <view class="wechat-id-row" wx:if="{{studioWechatId}}" bindtap="copyWechatId">
          <view class="wechat-info">
            <text class="wechat-label">老师微信号</text>
            <text class="wechat-id">{{studioWechatId}}</text>
          </view>
          <view class="copy-btn">复制</view>
        </view>
        <view class="qrcode-row" wx:if="{{studioQrcode}}" bindtap="previewQrcode">
          <image src="{{studioQrcode}}" mode="aspectFit" class="qrcode-img"/>
          <text class="qrcode-tip">长按识别二维码添加老师微信</text>
        </view>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn-share {{activity.started ? '' : 'disabled'}}" open-type="{{activity.started ? 'share' : ''}}" bindtap="{{activity.started ? '' : 'showNotStartedTip'}}">
      <image src="/images/icon-share-white.png" class="btn-icon"/>
      分享活动
    </button>
    <button class="btn-lottery" bindtap="goToLottery">
      <image src="/images/icon-lottery-white.png" class="btn-icon"/>
      立即抽奖
    </button>
  </view>
</view>
