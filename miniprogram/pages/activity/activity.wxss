/* ============================================
   活动页 - 晴空蓝·明朗欢快
   ============================================ */

.activity-page { min-height: 100vh; background: #F0F7FF; padding-bottom: 160rpx; }

.activity-cover { width: 100%; height: 420rpx; object-fit: cover; }

.activity-content { margin-top: -48rpx; position: relative; z-index: 1; padding: 0 24rpx; }

/* 活动头部 */
.activity-header {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(74, 158, 204, 0.1);
}

.activity-title { font-size: 36rpx; font-weight: 700; color: #1A2E3D; margin-bottom: 16rpx; line-height: 1.4; }

.activity-status {
  display: inline-block;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.activity-status.active { background: #E8F4FB; color: #4A9ECC; }
.activity-status.upcoming { background: #FEF8E7; color: #C08000; }

.activity-time { display: flex; align-items: center; color: #6A8099; font-size: 26rpx; }
.time-icon { width: 32rpx; height: 32rpx; margin-right: 10rpx; }

/* 活动详情和规则 */
.activity-body, .activity-rules {
  background: #FFFFFF;
  padding: 28rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(74, 158, 204, 0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2E3D;
  margin-bottom: 18rpx;
  padding-left: 18rpx;
  border-left: 5rpx solid #4A9ECC;
  display: flex;
  align-items: center;
}

.activity-desc { font-size: 28rpx; color: #4A5E6D; line-height: 1.9; }

.rules-list { padding: 8rpx 0; }

.rule-item {
  font-size: 26rpx;
  color: #4A5E6D;
  line-height: 2.2;
  padding-left: 20rpx;
  position: relative;
}

.rule-item::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 8rpx; height: 8rpx;
  background: #4A9ECC;
  border-radius: 50%;
}

/* 联系老师卡片 */
.contact-card {
  background: #FFFFFF;
  padding: 28rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(74, 158, 204, 0.1);
}

.contact-body { padding: 8rpx 0; }

.wechat-id-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F0F7FF;
  border-radius: 14rpx;
  padding: 22rpx;
}

.wechat-info { display: flex; flex-direction: column; }
.wechat-label { font-size: 24rpx; color: #6A8099; margin-bottom: 8rpx; }
.wechat-id { font-size: 30rpx; font-weight: 600; color: #1A2E3D; letter-spacing: 1rpx; }

.copy-btn {
  background: #4A9ECC;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 3rpx 10rpx rgba(74, 158, 204, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.copy-btn:active { transform: scale(0.96); }

.qrcode-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #DFF0FA;
}

.qrcode-img { width: 260rpx; height: 260rpx; border-radius: 12rpx; box-shadow: 0 2rpx 12rpx rgba(74, 158, 204, 0.12); }
.qrcode-tip { font-size: 24rpx; color: #A0B4C5; margin-top: 16rpx; }

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 10;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -1rpx 12rpx rgba(74, 158, 204, 0.12);
  border-top: 1rpx solid #DFF0FA;
}

.btn-share, .btn-lottery {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 200ms ease-out;
}

.btn-share {
  background: #FFFFFF;
  color: #4A9ECC;
  margin-right: 16rpx;
  border: 2rpx solid #4A9ECC;
}

.btn-share:active { background: #E8F4FB; transform: scale(0.98); }
.btn-share.disabled { background: #F5F5F5; color: #AAAAAA; border-color: #DDDDDD; }

.btn-lottery {
  background: #4A9ECC;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(74, 158, 204, 0.35);
}

.btn-lottery:active { transform: scale(0.98); background: #3A8EBC; }

.btn-icon { width: 38rpx; height: 38rpx; margin-right: 10rpx; }
