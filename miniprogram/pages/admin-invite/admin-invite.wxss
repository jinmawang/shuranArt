.invite-page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.invite-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  width: 100%;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.invite-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.invite-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.invite-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.invite-note {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 50rpx;
}

.invite-btn {
  background: #ff6b35 !important;
  color: #fff !important;
  border-radius: 40rpx !important;
  height: 88rpx;
  font-size: 32rpx;
  border: none;
  width: 80%;
  display: flex;
  align-items: center;
  justify-content: center;
}
