/* ============================================
   首页 - Claymorphism 蓝紫色系
   ============================================ */

.index-page {
  padding-bottom: 40rpx;
}

/* ============================================
   轮播图 - 圆角阴影效果
   ============================================ */
.banner-swiper {
  width: calc(100% - 48rpx);
  height: 380rpx;
  margin: 24rpx auto;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.2),
    -5rpx -5rpx 15rpx rgba(255, 255, 255, 0.8);
}

.banner-img {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}

/* ============================================
   画室介绍 - Claymorphism 卡片
   ============================================ */
.studio-intro {
  margin: 24rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(238,242,255,0.8));
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.15),
    -5rpx -5rpx 20rpx rgba(255, 255, 255, 0.9);
  border: 3rpx solid rgba(99, 102, 241, 0.1);
}

.studio-name {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: 2rpx;
}

.studio-slogan {
  font-size: 28rpx;
  color: #8B5CF6;
  margin: 16rpx 0;
  font-weight: 500;
}

.studio-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
  margin-top: 16rpx;
}

.studio-intro-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.8;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(99, 102, 241, 0.1);
  text-align: left;
}

/* ============================================
   画室地址 - 地图卡片
   ============================================ */
.studio-location {
  margin: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.15),
    -5rpx -5rpx 20rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
}

.location-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.location-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.location-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E1B4B;
  flex: 1;
}

.location-nav {
  font-size: 26rpx;
  color: #8B5CF6;
  padding: 8rpx 20rpx;
  background: rgba(139, 92, 246, 0.1);
  border-radius: 20rpx;
}

.location-address {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.studio-map {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* ============================================
   联系我们 - 二维码卡片
   ============================================ */
.contact-section {
  margin: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.15),
    -5rpx -5rpx 20rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
}

.qrcode-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.qrcode-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 16rpx;
  box-shadow:
    4rpx 4rpx 12rpx rgba(99, 102, 241, 0.2),
    -2rpx -2rpx 8rpx rgba(255, 255, 255, 0.9);
}

.qrcode-tip {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 16rpx;
}

/* ============================================
   功能入口 - 圆润图标网格
   ============================================ */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 32rpx 24rpx;
  background: rgba(255, 255, 255, 0.8);
  margin: 0 24rpx 24rpx;
  border-radius: 28rpx;
  box-shadow:
    8rpx 8rpx 24rpx rgba(99, 102, 241, 0.12),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 20rpx;
  transition: all 250ms ease-out;
}

.feature-item:active {
  transform: scale(0.95);
  background: rgba(99, 102, 241, 0.08);
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
  border-radius: 24rpx;
  box-shadow:
    4rpx 4rpx 12rpx rgba(99, 102, 241, 0.2),
    -2rpx -2rpx 8rpx rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.feature-item text {
  font-size: 24rpx;
  color: #4B5563;
  font-weight: 500;
}

/* ============================================
   区块标题
   ============================================ */
.section {
  margin: 0 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1E1B4B;
  padding: 24rpx 0 16rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #6366F1, #8B5CF6);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* ============================================
   活动列表 - Claymorphism 卡片
   ============================================ */
.activity-list {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow:
    8rpx 8rpx 24rpx rgba(99, 102, 241, 0.12),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
}

.activity-card {
  display: flex;
  padding: 24rpx;
  border-bottom: 2rpx solid rgba(99, 102, 241, 0.08);
  transition: all 200ms ease-out;
}

.activity-card:last-child {
  border-bottom: none;
}

.activity-card:active {
  background: rgba(99, 102, 241, 0.05);
}

.activity-cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  box-shadow:
    4rpx 4rpx 12rpx rgba(99, 102, 241, 0.15),
    -2rpx -2rpx 8rpx rgba(255, 255, 255, 0.6);
}

.activity-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E1B4B;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.activity-status-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.activity-status-tag.active {
  background: linear-gradient(135deg, #D1FAE5, #A7F3D0);
  color: #059669;
}

.activity-status-tag.upcoming {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  color: #D97706;
}

.activity-time {
  font-size: 24rpx;
  color: #8B5CF6;
  display: flex;
  align-items: center;
}

.activity-time::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  background: #A855F7;
  border-radius: 50%;
  margin-right: 10rpx;
}

/* ============================================
   空状态提示
   ============================================ */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

.empty-tip::before {
  content: '暂无活动';
  display: block;
  font-size: 48rpx;
  opacity: 0.3;
  margin-bottom: 16rpx;
}
