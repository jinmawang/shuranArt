.works-page { min-height: 100vh; background: #F0F7FF; }

.upload-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(74,158,204,0.1);
}
.upload-bar-text { font-size: 28rpx; color: #4A9ECC; font-weight: 500; }
.upload-bar-icon { font-size: 36rpx; color: #4A9ECC; margin-left: 12rpx; }

.waterfall { display: flex; padding: 0 24rpx; gap: 16rpx; }
.waterfall-col { flex: 1; display: flex; flex-direction: column; gap: 16rpx; }

.work-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(74,158,204,0.08);
}
.work-img { width: 100%; display: block; }
.work-info { padding: 16rpx; }
.work-child-name { font-size: 26rpx; font-weight: 600; color: #1A2E3D; }
.work-desc { font-size: 22rpx; color: #8899AA; margin-top: 6rpx; display: block; }

.empty-tip { text-align: center; padding: 120rpx 0; color: #A0B4C5; font-size: 28rpx; }
.loading-tip { text-align: center; padding: 40rpx 0; color: #A0B4C5; font-size: 24rpx; }
