<view class="upload-page">
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      上传作品
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>

  <!-- 上传说明 -->
  <view class="notice">
    <text>每个孩子最多保存最近30张作品，建议半个月上传一次，记录成长每一步。</text>
  </view>

  <!-- 选择孩子 -->
  <view class="section">
    <view class="section-title">选择孩子</view>
    <view class="child-list">
      <view class="child-chip {{selectedChildId === item.id ? 'active' : ''}}"
            wx:for="{{approvedChildren}}" wx:key="id"
            bindtap="selectChild" data-id="{{item.id}}">
        {{item.name}}
      </view>
      <view class="child-chip add" bindtap="showAddChildModal" wx:if="{{canAddChild}}">+ 添加孩子</view>
    </view>
    <view class="child-tip" wx:if="{{approvedChildren.length === 0}}">
      {{allChildren.length > 0 ? '孩子正在审核中，审核通过后即可上传作品' : '请先添加孩子，审核通过后即可上传作品'}}
    </view>
  </view>

  <!-- 上传图片（仅有审核通过的孩子时显示） -->
  <view class="section" wx:if="{{approvedChildren.length > 0}}">
    <view class="section-title">作品图片</view>
    <view class="image-picker" bindtap="chooseImage">
      <image wx:if="{{imageUrl}}" src="{{imageUrl}}" mode="aspectFill" class="picker-preview"/>
      <view wx:else class="picker-placeholder">
        <text class="picker-plus">+</text>
        <text class="picker-tip">点击上传作品</text>
      </view>
    </view>
  </view>

  <!-- 描述 -->
  <view class="section" wx:if="{{approvedChildren.length > 0}}">
    <view class="section-title">作品描述（选填）</view>
    <textarea class="desc-input" value="{{description}}" bindinput="onDescInput" placeholder="描述一下这幅作品吧" maxlength="100"/>
  </view>

  <!-- 提交 -->
  <view class="submit-bar" wx:if="{{approvedChildren.length > 0}}">
    <button class="submit-btn" bindtap="submit">提交作品</button>
  </view>

  <!-- 添加孩子弹窗 -->
  <view class="modal" wx:if="{{showAddChild}}">
    <view class="modal-mask" bindtap="closeAddChild"></view>
    <view class="modal-content">
      <view class="modal-title">添加孩子</view>
      <view class="modal-field">
        <text class="modal-label">孩子姓名</text>
        <input class="modal-input" value="{{newChildName}}" bindinput="onChildNameInput" placeholder="请输入孩子姓名"/>
      </view>
      <view class="modal-field">
        <text class="modal-label">申请理由</text>
        <textarea class="modal-textarea" value="{{newChildReason}}" bindinput="onChildReasonInput" placeholder="例如：孩子在画室学习素描课程" maxlength="100"/>
      </view>
      <view class="modal-actions">
        <button class="btn-cancel" bindtap="closeAddChild">取消</button>
        <button class="btn-confirm" bindtap="addChild">提交申请</button>
      </view>
    </view>
  </view>
</view>
