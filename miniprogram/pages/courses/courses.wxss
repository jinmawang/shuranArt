/* 课程列表页 */

.courses-page { min-height: 100vh; background: #F0F7FF; }

.page-header {
  background: #4A9ECC;
  padding: 60rpx 32rpx 48rpx;
  text-align: center;
}

.header-title { font-size: 42rpx; font-weight: 700; color: #fff; margin-bottom: 10rpx; }
.header-desc { font-size: 26rpx; color: rgba(255,255,255,0.88); }

/* 分类筛选栏 */
.category-bar {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(74,158,204,0.08);
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #F0F7FF;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4A5E6D;
  border: 1rpx solid #DFF0FA;
  transition: all 200ms ease-out;
  flex-shrink: 0;
  font-weight: 500;
}

.category-item.active {
  background: #4A9ECC;
  color: #fff;
  border-color: #4A9ECC;
  box-shadow: 0 3rpx 10rpx rgba(74,158,204,0.3);
}

.category-item:active { transform: scale(0.95); }

/* 课程列表 */
.course-list { padding: 20rpx 24rpx 24rpx; }

.course-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(74,158,204,0.1);
  transition: all 200ms ease-out;
}

.course-card:active { transform: scale(0.98); }
.course-cover { width: 100%; height: 300rpx; }
.course-info { padding: 22rpx 24rpx; }

.course-name { font-size: 32rpx; font-weight: 700; color: #1A2E3D; margin-bottom: 12rpx; line-height: 1.4; }

.course-category-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #4A9ECC;
  padding: 5rpx 14rpx;
  background: #E8F4FB;
  border-radius: 20rpx;
  font-weight: 500;
  margin-bottom: 14rpx;
}

.course-meta { display: flex; gap: 20rpx; margin-bottom: 10rpx; }

.course-suitable {
  font-size: 24rpx;
  color: #6A8099;
  display: flex;
  align-items: center;
}

.course-suitable::before {
  content: '';
  width: 10rpx; height: 10rpx;
  background: #A0B4C5;
  border-radius: 50%;
  margin-right: 8rpx;
}

.course-desc {
  font-size: 24rpx;
  color: #8899AA;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.empty-tip { text-align: center; padding: 120rpx 0; color: #A0B4C5; font-size: 28rpx; }
