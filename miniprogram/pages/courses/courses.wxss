/* 课程列表页 */

.courses-page { min-height: 100vh; background: #F0F7FF; display: flex; flex-direction: column; }

/* 分类筛选栏 */
.category-bar {
  display: flex;
  padding: 20rpx 24rpx;
  white-space: nowrap;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(74,158,204,0.08);
  flex-shrink: 0;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: #F0F7FF;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4A5E6D;
  border: 1rpx solid #DFF0FA;
  margin-right: 14rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.category-item.active {
  background: #4A9ECC;
  color: #fff;
  border-color: #4A9ECC;
  box-shadow: 0 3rpx 10rpx rgba(74,158,204,0.3);
}

.category-item:active { transform: scale(0.95); }

/* 滚动区域 */
.course-scroll {
  flex: 1;
}

/* 分组区块 */
.section-block {
  padding: 24rpx 24rpx 0;
}

.section-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A2E3D;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.section-label::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: #4A9ECC;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

/* 课程列表 */
.course-list { display: flex; flex-direction: column; gap: 16rpx; }

.course-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(74,158,204,0.1);
}

.course-card:active { transform: scale(0.98); }

.builtin-card {
  border: 1rpx solid #DFF0FA;
}

.course-cover { width: 100%; height: 280rpx; }
.course-info { padding: 22rpx 24rpx; }

.course-name { font-size: 32rpx; font-weight: 700; color: #1A2E3D; margin-bottom: 12rpx; }

.course-tags { display: flex; gap: 12rpx; margin-bottom: 14rpx; flex-wrap: wrap; }

.course-category-tag {
  font-size: 22rpx;
  color: #4A9ECC;
  padding: 4rpx 14rpx;
  background: #E8F4FB;
  border-radius: 20rpx;
  font-weight: 500;
}

.course-age-tag {
  font-size: 22rpx;
  color: #6A8099;
  padding: 4rpx 14rpx;
  background: #F0F7FF;
  border-radius: 20rpx;
}

.course-desc {
  font-size: 24rpx;
  color: #8899AA;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.course-duration {
  font-size: 22rpx;
  color: #A0B4C5;
}

.empty-tip { text-align: center; padding: 120rpx 0; color: #A0B4C5; font-size: 28rpx; }
