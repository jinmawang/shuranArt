<view class="courses-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      课程介绍
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>

  <!-- 分类筛选栏 -->
  <scroll-view scroll-x class="category-bar">
    <view class="category-item {{currentCategory === item ? 'active' : ''}}"
          wx:for="{{categories}}" wx:key="index"
          bindtap="onCategoryTap" data-category="{{item}}">
      {{item}}
    </view>
  </scroll-view>

  <!-- 课程列表 -->
  <view class="course-list">
    <view class="course-card" wx:for="{{courses}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image src="{{item.coverImg || '/images/default-course.png'}}" mode="aspectFill" class="course-cover"/>
      <view class="course-info">
        <view class="course-name">{{item.name}}</view>
        <view class="course-tags">
          <view class="course-category-tag">{{item.category}}</view>
          <view class="course-age-tag" wx:if="{{item.suitableFor}}">{{item.suitableFor}}</view>
        </view>
        <view class="course-desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
    </view>

    <view wx:if="{{courses.length === 0}}" class="empty-tip">
      {{currentCategory !== '全部' ? '该类别暂无课程' : '暂无课程信息'}}
    </view>
  </view>
</view>
