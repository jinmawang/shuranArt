<!-- CRS: 课程列表页 -->
<!-- 需求来源: EARS-CRS-001, EARS-CRS-002, AC-CRS-001, AC-CRS-002 -->
<!-- 参照 teachers/teachers.wxml 页面结构 -->
<view class="courses-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack">&lt;</view>
      课程介绍
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>
  <view class="page-header">
    <view class="header-title">课程介绍</view>
    <view class="header-desc">专业课程，系统教学</view>
  </view>

  <!-- EARS-CRS-002: 分类筛选栏 (AC-CRS-002) -->
  <view class="category-bar">
    <view class="category-item {{currentCategory === item ? 'active' : ''}}"
          wx:for="{{categories}}" wx:key="index"
          bindtap="onCategoryTap" data-category="{{item}}">
      {{item}}
    </view>
  </view>

  <!-- EARS-CRS-001: 课程列表 (AC-CRS-001) -->
  <view class="course-list">
    <view class="course-card" wx:for="{{courses}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <!-- B3: 封面图加载失败时显示默认占位图 -->
      <image src="{{item.coverImg || '/images/default-course.png'}}" mode="aspectFill" class="course-cover"/>
      <view class="course-info">
        <view class="course-name">{{item.name}}</view>
        <view class="course-category-tag">{{item.category}}</view>
        <view class="course-meta">
          <text class="course-duration">{{item.duration}}</text>
          <text class="course-suitable">{{item.suitableFor}}</text>
        </view>
        <!-- B1: price=0 显示"免费" -->
        <view class="course-price">
          <text wx:if="{{item.price === 0}}" class="price-free">免费</text>
          <text wx:else class="price-amount">¥{{item.price}}</text>
        </view>
      </view>
    </view>

    <!-- AC-CRS-001: 空列表提示 / B4: 所有课程都被下架 / B5: 筛选无结果 -->
    <view wx:if="{{courses.length === 0}}" class="empty-tip">
      {{currentCategory !== '全部' ? '该类别暂无课程' : '暂无课程信息'}}
    </view>
  </view>
</view>
