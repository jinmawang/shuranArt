<view class="share-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      邀请好友
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>
  <!-- 活动信息 -->
  <view class="activity-header">
    <image src="{{activity.coverImg || '/images/default-activity.png'}}" mode="aspectFill" class="activity-bg"/>
    <view class="activity-overlay">
      <view class="activity-title">{{activity.title}}</view>
      <view class="activity-desc">{{activity.description}}</view>
    </view>
  </view>

  <!-- 分享说明 -->
  <view class="card share-info">
    <view class="section-title">分享规则</view>
    <view class="rules">
      <view class="rule-item">
        <view class="rule-num">1</view>
        <text>点击下方分享按钮，将活动分享给好友</text>
      </view>
      <view class="rule-item">
        <view class="rule-num">2</view>
        <text>好友通过您分享的链接访问活动</text>
      </view>
      <view class="rule-item">
        <view class="rule-num">3</view>
        <text>每成功邀请1位好友，您获得1次抽奖机会</text>
      </view>
      <view class="rule-item">
        <view class="rule-num">4</view>
        <text>每个活动最多可获得{{shareStatus.totalLimit || 5}}次抽奖机会</text>
      </view>
    </view>
  </view>

  <!-- 我的邀请 -->
  <view class="card my-invite">
    <view class="invite-stat">
      <view class="stat-item">
        <view class="stat-num">{{shareStatus.confirmedShares || 0}}/{{shareStatus.totalLimit || 5}}</view>
        <view class="stat-label">已成功邀请</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{userInfo.lotteryChances || 0}}</view>
        <view class="stat-label">当前抽奖次数</view>
      </view>
    </view>
    <view class="invite-tip" wx:if="{{!shareStatus.canShare}}">
      该活动分享次数已达上限
    </view>
  </view>

  <!-- 分享按钮 -->
  <view class="share-action">
    <button class="btn-primary share-btn {{shareStatus.canShare === false ? 'disabled' : ''}}"
            open-type="{{shareStatus.canShare === false ? '' : 'share'}}"
            bindtap="{{shareStatus.canShare === false ? 'showLimitTip' : ''}}">
      <image src="/images/icon-share-white.png" class="share-icon"/>
      {{shareStatus.canShare === false ? '分享次数已达上限' : '立即分享'}}
    </button>
  </view>
</view>
