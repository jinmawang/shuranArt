/* ============================================
   分享页 - Claymorphism 蓝紫色系
   ============================================ */

.share-page {
  min-height: 100vh;
  padding-bottom: 220rpx;
}

/* ============================================
   活动头部
   ============================================ */
.activity-header {
  position: relative;
  height: 420rpx;
  overflow: hidden;
}

.activity-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.activity-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 48rpx 32rpx;
  background: linear-gradient(transparent, rgba(30, 27, 75, 0.85));
  color: #fff;
}

.activity-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.activity-desc {
  font-size: 26rpx;
  opacity: 0.95;
  line-height: 1.5;
}

/* ============================================
   分享规则卡片 - Claymorphism
   ============================================ */
.share-info {
  margin: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.15),
    -5rpx -5rpx 20rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E1B4B;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #6366F1, #8B5CF6);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.rules {
  padding: 12rpx 0;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-num {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #6366F1, #8B5CF6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow:
    4rpx 4rpx 10rpx rgba(99, 102, 241, 0.3),
    -2rpx -2rpx 6rpx rgba(139, 92, 246, 0.2);
}

.rule-item text {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 48rpx;
}

/* ============================================
   我的邀请卡片 - Claymorphism
   ============================================ */
.my-invite {
  margin: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.15),
    -5rpx -5rpx 20rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
}

.invite-stat {
  display: flex;
  justify-content: center;
}

.stat-item {
  text-align: center;
  padding: 24rpx 64rpx;
}

.stat-num {
  font-size: 60rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #6366F1, #A855F7);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.stat-label {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 12rpx;
  font-weight: 500;
}

/* ============================================
   分享按钮区 - Claymorphism
   ============================================ */
.share-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  box-shadow:
    0 -8rpx 24rpx rgba(99, 102, 241, 0.1);
  border-top: 2rpx solid rgba(99, 102, 241, 0.08);
}

.share-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow:
    8rpx 8rpx 24rpx rgba(99, 102, 241, 0.4),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.3);
  transition: all 250ms ease-out;
}

.share-btn:active {
  transform: scale(0.98);
  box-shadow:
    4rpx 4rpx 16rpx rgba(99, 102, 241, 0.5),
    -2rpx -2rpx 10rpx rgba(255, 255, 255, 0.2);
}

.share-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}
