/* ============================================
   分享页 - 晴空蓝·明朗欢快
   ============================================ */

.share-page { min-height: 100vh; background: #F0F7FF; padding-bottom: 200rpx; }

.activity-header { position: relative; height: 400rpx; overflow: hidden; }
.activity-bg { width: 100%; height: 100%; object-fit: cover; }

.activity-overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 44rpx 28rpx;
  background: linear-gradient(transparent, rgba(26,46,61,0.55));
  color: #fff;
}

.activity-title { font-size: 36rpx; font-weight: 700; margin-bottom: 10rpx; }
.activity-desc { font-size: 26rpx; opacity: 0.9; line-height: 1.5; }

.share-info {
  margin: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(74,158,204,0.1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2E3D;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx; height: 28rpx;
  background: #4A9ECC;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.rules { padding: 8rpx 0; }

.rule-item { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.rule-item:last-child { margin-bottom: 0; }

.rule-num {
  width: 44rpx; height: 44rpx;
  background: #4A9ECC;
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-item text { font-size: 28rpx; color: #4A5E6D; line-height: 44rpx; }

.my-invite {
  margin: 0 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(74,158,204,0.1);
}

.invite-stat { display: flex; justify-content: center; }
.stat-item { text-align: center; padding: 20rpx 56rpx; }
.stat-num { font-size: 56rpx; font-weight: 700; color: #4A9ECC; }
.stat-label { font-size: 26rpx; color: #6A8099; margin-top: 10rpx; font-weight: 500; }
.stat-divider { width: 1rpx; height: 72rpx; background: #DFF0FA; align-self: center; }

.invite-tip {
  text-align: center;
  font-size: 26rpx;
  color: #C08000;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF6FC;
}

.share-action {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 10;
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.97);
  box-shadow: 0 -1rpx 12rpx rgba(74,158,204,0.12);
  border-top: 1rpx solid #DFF0FA;
}

.share-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 92rpx;
  background: #4A9ECC;
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(74,158,204,0.35);
  transition: all 200ms ease-out;
}

.share-btn:active { transform: scale(0.98); background: #3A8EBC; }
.share-btn.disabled { background: #CCCCCC; box-shadow: none; }
.share-btn.disabled:active { transform: none; }
.share-icon { width: 38rpx; height: 38rpx; margin-right: 12rpx; }
