.share-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 200rpx;
}

/* 活动头部 */
.activity-header {
  position: relative;
  height: 400rpx;
}

.activity-bg {
  width: 100%;
  height: 100%;
}

.activity-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: #fff;
}

.activity-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.activity-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 分享规则 */
.share-info {
  margin: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.rules {
  padding: 10rpx 0;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-num {
  width: 44rpx;
  height: 44rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-item text {
  font-size: 28rpx;
  color: #666;
  line-height: 44rpx;
}

/* 我的邀请 */
.my-invite {
  margin: 20rpx;
}

.invite-stat {
  display: flex;
  justify-content: center;
}

.stat-item {
  text-align: center;
  padding: 20rpx 60rpx;
}

.stat-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #ff6b35;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 分享按钮 */
.share-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.share-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.share-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}
