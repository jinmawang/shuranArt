<view class="detail-page" wx:if="{{course}}">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px; position:relative;">
      <view class="custom-nav-back" bindtap="goBack"></view>
      课程详情
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>

  <image src="{{course.coverImg || '/images/default-course.png'}}" mode="aspectFill" class="detail-cover" binderror="onImageError"/>

  <!-- 课程基本信息 -->
  <view class="detail-card">
    <view class="detail-name">{{course.name}}</view>
    <view class="detail-category-tag">{{course.category}}</view>

    <view class="detail-tags" wx:if="{{course.suitableFor}}">
      <view class="detail-tag">
        <text class="tag-label">适合年龄</text>
        <text class="tag-value">{{course.suitableFor}}</text>
      </view>
    </view>
  </view>

  <!-- 课程详细描述 -->
  <view class="detail-card" wx:if="{{course.description}}">
    <view class="card-title">课程介绍</view>
    <rich-text nodes="{{course.description}}" class="detail-description"></rich-text>
  </view>
</view>

<view wx:if="{{!course && !loading}}" class="empty-page">
  <text class="empty-text">课程不存在</text>
</view>
<view wx:if="{{loading}}" class="loading-page">
  <text class="loading-text">加载中...</text>
</view>
