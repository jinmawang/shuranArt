/* ============================================
   我的页 - 晴空蓝·明朗欢快
   ============================================ */

.my-page { min-height: 100vh; background: #F0F7FF; }

/* 用户头部 */
.user-header {
  background: #4A9ECC;
  padding: 64rpx 32rpx 88rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
  position: relative;
  z-index: 1;
}

.user-info { flex: 1; margin-left: 28rpx; color: #fff; position: relative; z-index: 1; }
.user-name { font-size: 36rpx; font-weight: 700; margin-bottom: 18rpx; }
.user-stats { display: flex; align-items: center; }
.stat-item { display: flex; flex-direction: column; }
.stat-num { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: 0.88; margin-top: 4rpx; }
.stat-divider { width: 1rpx; height: 48rpx; background: rgba(255,255,255,0.4); margin: 0 36rpx; }

/* 菜单列表 */
.menu-list {
  background: #FFFFFF;
  margin: -44rpx 24rpx 20rpx;
  border-radius: 20rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 20rpx rgba(74,158,204,0.12);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #EEF6FC;
  transition: all 200ms ease-out;
}

.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #F7FBFF; }

.menu-item-btn {
  display: block !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: normal !important;
  width: 100% !important;
  text-align: left !important;
  overflow: visible !important;
  min-height: 0 !important;
}
.menu-item-btn::after { display: none !important; }

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 22rpx;
  padding: 8rpx;
  background: #E8F4FB;
  border-radius: 10rpx;
}

.menu-title { flex: 1; font-size: 30rpx; color: #1A2E3D; font-weight: 500; }

.menu-arrow-css {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #C0C0C0;
  border-right: 3rpx solid #C0C0C0;
  transform: rotate(45deg);
}

/* 记录区块 */
.records-section { margin: 0 24rpx 20rpx; }

.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; padding: 4rpx 0; }

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2E3D;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: #4A9ECC;
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-more { font-size: 26rpx; color: #4A9ECC; font-weight: 500; }

/* 记录列表 */
.record-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(74,158,204,0.1);
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEF6FC;
  transition: all 200ms ease-out;
}

.record-item:last-child { border-bottom: none; }
.record-item:active { background: #F7FBFF; }

.record-icon {
  width: 68rpx;
  height: 68rpx;
  margin-right: 20rpx;
  padding: 10rpx;
  background: #E8F4FB;
  border-radius: 14rpx;
}

.record-info { flex: 1; }
.record-name { font-size: 28rpx; color: #1A2E3D; margin-bottom: 6rpx; font-weight: 500; }
.record-time { font-size: 24rpx; color: #A0B4C5; }

.record-status { font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 24rpx; font-weight: 500; }
.record-status.pending { background: #FEF8E7; color: #C08000; }
.record-status.claimed { background: #E8F4FB; color: #4A9ECC; }
.record-status.expired { background: #F5F5F5; color: #999999; }

.empty-tip { text-align: center; padding: 64rpx 0; color: #A0B4C5; font-size: 28rpx; }

/* 头像按钮 */
.avatar-btn { background: transparent; padding: 0; margin: 0; border: none; line-height: normal; width: 140rpx; height: 140rpx; }
.avatar-btn::after { border: none; }

/* 昵称输入框 */
.nickname-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 18rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 10rpx;
  padding: 8rpx 14rpx;
  width: 260rpx;
}

.nickname-input::placeholder { color: rgba(255,255,255,0.65); font-weight: 400; font-size: 26rpx; }

.edit-tip {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  background: rgba(0,0,0,0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  z-index: 1;
}
