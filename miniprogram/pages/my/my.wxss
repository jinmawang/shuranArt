/* ============================================
   我的页 - Claymorphism 蓝紫色系
   ============================================ */

.my-page {
  min-height: 100vh;
}

/* ============================================
   用户头部
   ============================================ */
.user-header {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #A855F7 100%);
  padding: 72rpx 32rpx 96rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.user-header::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.user-header::after {
  content: '';
  position: absolute;
  bottom: -40%;
  left: -10%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  border-radius: 50%;
}

.user-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  box-shadow:
    8rpx 8rpx 24rpx rgba(99, 102, 241, 0.3),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}

.user-info {
  flex: 1;
  margin-left: 32rpx;
  color: #fff;
  position: relative;
  z-index: 1;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.user-stats {
  display: flex;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.35);
  margin: 0 44rpx;
  border-radius: 2rpx;
}

/* ============================================
   菜单列表 - Claymorphism
   ============================================ */
.menu-list {
  background: rgba(255, 255, 255, 0.9);
  margin: -48rpx 24rpx 24rpx;
  border-radius: 28rpx;
  position: relative;
  z-index: 2;
  box-shadow:
    10rpx 10rpx 30rpx rgba(99, 102, 241, 0.15),
    -5rpx -5rpx 20rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 2rpx solid rgba(99, 102, 241, 0.06);
  transition: all 200ms ease-out;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(99, 102, 241, 0.05);
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  padding: 8rpx;
  background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
  border-radius: 12rpx;
}

.menu-title {
  flex: 1;
  font-size: 30rpx;
  color: #374151;
  font-weight: 500;
}

.menu-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.35;
}

/* ============================================
   记录区块
   ============================================ */
.records-section {
  margin: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E1B4B;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #6366F1, #8B5CF6);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-more {
  font-size: 26rpx;
  color: #8B5CF6;
  font-weight: 500;
}

/* ============================================
   记录列表 - Claymorphism
   ============================================ */
.record-list {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  box-shadow:
    8rpx 8rpx 24rpx rgba(99, 102, 241, 0.12),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(99, 102, 241, 0.08);
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 2rpx solid rgba(99, 102, 241, 0.06);
  transition: all 200ms ease-out;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:active {
  background: rgba(99, 102, 241, 0.05);
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  padding: 10rpx;
  background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
  border-radius: 16rpx;
  box-shadow:
    3rpx 3rpx 8rpx rgba(99, 102, 241, 0.12),
    -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.8);
}

.record-info {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.record-time {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* ============================================
   状态标签 - Claymorphism
   ============================================ */
.record-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.record-status.pending {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  color: #D97706;
  box-shadow: 2rpx 2rpx 6rpx rgba(217, 119, 6, 0.15);
}

.record-status.claimed {
  background: linear-gradient(135deg, #D1FAE5, #A7F3D0);
  color: #059669;
  box-shadow: 2rpx 2rpx 6rpx rgba(5, 150, 105, 0.15);
}

.record-status.expired {
  background: linear-gradient(135deg, #F3F4F6, #E5E7EB);
  color: #6B7280;
}

/* ============================================
   空状态
   ============================================ */
.empty-tip {
  text-align: center;
  padding: 72rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* ============================================
   头像按钮 - 用于选择头像
   ============================================ */
.avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
  width: 150rpx;
  height: 150rpx;
}

.avatar-btn::after {
  border: none;
}

/* ============================================
   昵称输入框
   ============================================ */
.nickname-input {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  width: 280rpx;
}

.nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
  font-size: 28rpx;
}

/* ============================================
   编辑提示
   ============================================ */
.edit-tip {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(0, 0, 0, 0.2);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  z-index: 1;
}
