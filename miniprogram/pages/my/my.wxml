<view class="my-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height:{{navBarTotalHeight}}px;">
    <view style="height:{{statusBarHeight}}px;"></view>
    <view class="custom-nav-title" style="height:{{navBarHeight}}px;">我的</view>
  </view>
  <view style="height:{{navBarTotalHeight}}px;"></view>

  <!-- 用户信息 -->
  <view class="user-header">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image src="{{tempAvatarUrl || userInfo.avatarUrl || defaultAvatar}}" class="user-avatar"/>
    </button>
    <view class="user-info">
      <view class="user-name" wx:if="{{userInfo.nickName}}">{{userInfo.nickName}}</view>
      <input wx:else class="nickname-input" type="nickname" placeholder="点击设置昵称" bindinput="onInputNickname" bindblur="onNicknameBlur"/>
      <view class="user-stats">
        <view class="stat-item">
          <text class="stat-num">{{userInfo.points || 0}}</text>
          <text class="stat-label">积分</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{userInfo.lotteryChances || 0}}</text>
          <text class="stat-label">抽奖次数</text>
        </view>
      </view>
    </view>
    <view class="edit-tip" wx:if="{{!userInfo.nickName}}">点击完善昵称</view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToShare">
      <image src="/images/icon-invite.png" class="menu-icon"/>
      <text class="menu-title">邀请好友</text>
      <image src="/images/icon-arrow.png" class="menu-arrow"/>
    </view>
    <view class="menu-item admin-entry" bindtap="goToAdmin" wx:if="{{isAdmin}}">
      <image src="/images/icon-admin.png" class="menu-icon"/>
      <text class="menu-title">管理后台</text>
      <image src="/images/icon-arrow.png" class="menu-arrow"/>
    </view>
  </view>

  <!-- 中奖记录 -->
  <view class="card records-section">
    <view class="section-header">
      <text class="section-title">最近中奖</text>
    </view>
    <view class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <image src="{{item.icon || '/images/prize-default.png'}}" class="record-icon"/>
        <view class="record-info">
          <view class="record-name">{{item.prizeName}}</view>
          <view class="record-time">{{item.createdAt}}</view>
        </view>
        <view class="record-status {{item.status}}">
          <text wx:if="{{item.status === 'pending'}}">待领取</text>
          <text wx:if="{{item.status === 'claimed'}}">已领取</text>
          <text wx:if="{{item.status === 'expired'}}">已过期</text>
        </view>
      </view>
      <view wx:if="{{records.length === 0}}" class="empty-tip">暂无中奖记录</view>
    </view>
  </view>
</view>
